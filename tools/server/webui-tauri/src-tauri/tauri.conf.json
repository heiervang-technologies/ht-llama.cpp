{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ht-llama-webui",
  "version": "0.1.0",
  "identifier": "com.heiervang.htllama.webui",
  "build": {
    "frontendDist": "../../public",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../webui && bun run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "cd ../webui && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "ht-llama.cpp",
        "url": "http://localhost:5173/#/",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
