Name=ht-llama.cpp WebUI
GenericName=LLM Chat
Comment=Native desktop shell for the ht-llama.cpp WebUI
Exec=env GDK_BACKEND=x11 WEBKIT_DISABLE_COMPOSITING_MODE=1 ht-llama-webui
